<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">

<policyconfig>
  <vendor>Xen Installer</vendor>
  <vendor_url>https://github.com/XeroLinux</vendor_url>
  <icon_name>system-installer</icon_name>

  <action id="org.xen.installer.run">
    <description>Run the Xen installer</description>
    <description xml:lang="fr">Exécuter l'installateur Xen</description>
    <message>Authentication is required to run the Xen installer</message>
    <message xml:lang="fr">L'authentification est requise pour exécuter l'installateur Xen</message>
    <defaults>
      <!-- The live ISO user is allowed without a password by 49-xen-installer-live.rules. -->
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/xen/xen-root-launch</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
