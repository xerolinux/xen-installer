#!/bin/bash
# pkexec strips WAYLAND_DISPLAY and XDG_RUNTIME_DIR, so they are handed to
# the root-side launcher as arguments; it validates them before use.
if command -v pkexec >/dev/null 2>&1; then
	exec pkexec --disable-internal-agent /usr/lib/xen/xen-root-launch \
		"${WAYLAND_DISPLAY:-}" "${XDG_RUNTIME_DIR:-}" "$@"
else
	exec /usr/bin/xen "$@"
fi
