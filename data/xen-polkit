#!/bin/bash
# Desktop-launch wrapper: runs Xen as root, matching how XeroLinux's Calamares
# is launched (see calamaresx-app's calamares_polkit). --no-fork makes the GUI
# process itself the one that performs partitioning/install/bootloader,
# instead of forking a second privileged engine over IPC.
if [ "$(which pkexec)" ]; then
	exec pkexec --disable-internal-agent /usr/bin/xen --no-fork "$@"
else
	exec /usr/bin/xen --no-fork "$@"
fi
